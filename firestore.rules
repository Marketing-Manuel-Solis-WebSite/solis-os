rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======== HELPER FUNCTIONS ========

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.active == true;
    }

    function getRole(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    function isOwner(orgId) {
      return isOrgMember(orgId) && getRole(orgId) == 'owner';
    }

    function isAdmin(orgId) {
      return isOrgMember(orgId) && (getRole(orgId) == 'owner' || getRole(orgId) == 'admin');
    }

    function isManager(orgId) {
      return isOrgMember(orgId) && (getRole(orgId) in ['owner', 'admin', 'manager']);
    }

    function isSelf(userId) {
      return request.auth.uid == userId;
    }

    function hasOrgId(orgId) {
      return request.resource.data.orgId == orgId;
    }

    // ======== ORGANIZATIONS ========

    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn(); // Creating new org
      allow update: if isAdmin(orgId);
      allow delete: if isOwner(orgId);

      // Members (was "memberships" — fixed to match code path orgs/{orgId}/members)
      match /members/{userId} {
        allow read: if isOrgMember(orgId);
        allow create: if isAdmin(orgId);
        // Admins can update any field; members can only update non-sensitive fields on themselves
        allow update: if isAdmin(orgId) ||
          (isSelf(userId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'hierarchyLevel']));
        allow delete: if isOwner(orgId);

        // User preferences (stored per-member)
        match /preferences/{prefKey} {
          allow read: if isSignedIn() && isSelf(userId);
          allow write: if isSignedIn() && isSelf(userId);
        }
      }

      // Invitations
      match /invitations/{inviteId} {
        allow read: if isOrgMember(orgId);
        allow create: if isAdmin(orgId);
        allow update: if isAdmin(orgId);
        allow delete: if isAdmin(orgId);
      }

      // Settings
      match /settings/{settingId} {
        allow read: if isOrgMember(orgId);
        allow write: if isAdmin(orgId);
      }

      // Teams
      match /teams/{teamId} {
        allow read: if isOrgMember(orgId);
        allow create: if isAdmin(orgId);
        allow update: if isManager(orgId);
        allow delete: if isAdmin(orgId);
      }

      // Presence
      match /presence/{userId} {
        allow read: if isOrgMember(orgId);
        allow write: if isSignedIn() && isSelf(userId);
      }

      // Read cursors — tracks which messages each user has read per channel
      match /readCursors/{userId} {
        allow read: if isSignedIn() && isOrgMember(orgId);
        allow write: if isSignedIn() && isSelf(userId);
      }

      // Notifications (code writes to orgs/{orgId}/notifications)
      match /notifications/{notifId} {
        allow read: if isSignedIn() && isSelf(resource.data.userId);
        allow create: if isSignedIn() && isOrgMember(orgId);
        allow update: if isSignedIn() && isSelf(resource.data.userId); // Mark as read
        allow delete: if isSignedIn() && isSelf(resource.data.userId);
      }

      // Dashboards
      match /dashboards/{dashId} {
        allow read: if isSignedIn() && isSelf(resource.data.userId);
        allow create: if isSignedIn() && isOrgMember(orgId);
        allow update: if isSignedIn() && isSelf(resource.data.userId);
        allow delete: if isSignedIn() && isSelf(resource.data.userId);
      }

      // Inbox
      match /inbox/{itemId} {
        allow read: if isSignedIn() && isOrgMember(orgId);
        allow create: if isSignedIn() && isOrgMember(orgId);
        allow update: if isSignedIn() && isOrgMember(orgId);
        allow delete: if isSignedIn() && isOrgMember(orgId);
      }

      // AI Conversations
      match /ai-conversations/{convId} {
        allow read: if isSignedIn() && isOrgMember(orgId);
        allow create: if isSignedIn() && isOrgMember(orgId);
        allow update: if isSignedIn() && isOrgMember(orgId);
        allow delete: if isSignedIn() && isOrgMember(orgId);

        match /messages/{msgId} {
          allow read: if isSignedIn() && isOrgMember(orgId);
          allow create: if isSignedIn() && isOrgMember(orgId);
          allow update, delete: if false;
        }
      }
    }

    // ======== USER PROFILES ========

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false; // Prevent user self-deletion
    }

    // ======== WORKSPACES ========

    match /workspaces/{workspaceId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isAdmin(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== SPACES ========

    match /spaces/{spaceId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== FOLDERS ========

    match /folders/{folderId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    // ======== LISTS ========

    match /lists/{listId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    // ======== TASKS ========

    match /tasks/{taskId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      // Cross-org leak fix: verify parent task's orgId for subcollections
      match /comments/{commentId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow update: if isSignedIn() && request.auth.uid == resource.data.createdBy;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;
      }

      match /activity/{activityId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow update, delete: if false; // Activity log is immutable
      }
    }

    // ======== DOCS ========

    match /docs/{docId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /revisions/{revisionId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        allow update, delete: if false; // Revisions are immutable
      }
    }

    // ======== CHANNELS ========

    match /channels/{channelId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);

      // Cross-org leak fix: verify parent channel's orgId
      match /messages/{messageId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId);
        allow update: if isSignedIn() && request.auth.uid == resource.data.createdBy;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;
      }

      // Typing indicators and channel metadata
      match /meta/{docId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId);
        allow write: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId);
      }
    }

    // ======== GOALS ========

    match /goals/{goalId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /targets/{targetId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow delete: if isSignedIn() && isManager(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
      }
    }

    // ======== WHITEBOARDS ========

    match /whiteboards/{boardId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /elements/{elementId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
        allow delete: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
      }
    }

    // ======== FORMS ========

    match /forms/{formId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      // Public form access by publicToken is handled via API routes, not direct Firestore reads
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /submissions/{subId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow create: if false; // Public submissions go through /api/forms/submit (Admin SDK) — no direct client writes
        allow update, delete: if isSignedIn() && isAdmin(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
      }

      match /mappings/{mappingId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow delete: if isSignedIn() && isAdmin(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
      }
    }

    // ======== TIME ENTRIES ========

    match /time-entries/{entryId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isManager(resource.data.orgId));
    }

    // ======== AUTOMATIONS ========

    match /automations/{automationId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);

      match /logs/{logId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/automations/$(automationId)).data.orgId);
        allow create: if false; // Only Cloud Functions write logs
        allow update, delete: if false;
      }
    }

    // ======== NOTIFICATIONS (top-level — legacy, kept for backwards compat) ========

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn(); // Allow client-side notification creation
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId; // Mark as read
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ======== AUDIT LOGS ========

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      // Users can only create audit entries where actorId matches their own UID (prevents fabrication)
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false; // Audit logs are immutable
    }

    // ======== INSIGHTS ========

    match /insights/{insightId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if false; // Only Cloud Functions / server-side
      allow update, delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== TEMPLATES ========

    match /templates/{templateId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== EMAIL TEMPLATES ========

    match /emailTemplates/{templateId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow write: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== ROLES ========

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== CUSTOM FIELD SCHEMAS ========

    match /customFieldSchemas/{schemaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin(request.resource.data.orgId);
    }

    // ======== INTEGRATIONS ========

    match /integrations/{integrationId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== API KEYS ========

    match /apiKeys/{keyId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      allow create: if isSignedIn() && isAdmin(request.resource.data.orgId);
      allow update: if isSignedIn() && isAdmin(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== WEBHOOKS ========

    match /webhooks/{webhookId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);

      match /logs/{logId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/webhooks/$(webhookId)).data.orgId);
        allow create: if false; // Only server-side
        allow update, delete: if false;
      }
    }

    // ======== INCOMING WEBHOOKS ========

    match /incomingWebhooks/{webhookId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId);
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== WEBHOOK EVENTS ========

    match /webhookEvents/{eventId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      allow create: if false; // Only server-side
      allow update, delete: if false;
    }

    // ======== CRM ========

    match /contacts/{contactId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    match /deals/{dealId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    match /cases/{caseId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    // Entity Relations
    match /relations/{relationId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.createdBy || isManager(resource.data.orgId));
      allow update: if false;
    }

    // Import Logs
    match /importLogs/{logId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update, delete: if false;
    }
  }
}
