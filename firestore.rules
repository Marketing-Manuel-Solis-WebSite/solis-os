rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======== MULTI-TENANT NOTE ========
    // When the 'multi-tenant' feature flag is fully enabled, orgId validation
    // should be added to all write rules to ensure request.resource.data.orgId
    // matches the authenticated user's org membership. Currently the app is
    // single-tenant (orgId = 'solis-center'), so orgId is implicitly trusted.
    // See lib/org.ts for the multi-tenant runtime infrastructure.

    // ======== HELPER FUNCTIONS ========

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.active == true;
    }

    function getRole(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    function isOwner(orgId) {
      return isOrgMember(orgId) && getRole(orgId) == 'owner';
    }

    function isAdmin(orgId) {
      return isOrgMember(orgId) && (getRole(orgId) == 'owner' || getRole(orgId) == 'admin');
    }

    function isManager(orgId) {
      return isOrgMember(orgId) && (getRole(orgId) in ['owner', 'admin', 'manager']);
    }

    // Guest role — can read but has restricted write access
    function isGuest(orgId) {
      return isOrgMember(orgId) && getRole(orgId) == 'guest';
    }

    // Full member — not guest and not readonly
    function isFullMember(orgId) {
      return isOrgMember(orgId) && !(getRole(orgId) in ['guest', 'readonly']);
    }

    function isSelf(userId) {
      return request.auth.uid == userId;
    }

    function hasOrgId(orgId) {
      return request.resource.data.orgId == orgId;
    }

    // Prevent orgId from being changed on update (cross-tenant migration attack)
    function orgIdUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId']);
    }

    // Team-level access: admin/director bypass, or document has no teamId, or user is a member of the document's team.
    // Used for tasks, docs, goals to enforce team isolation within the org.
    function canAccessTeamData(orgId) {
      let member = get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
      return member.role in ['owner', 'admin']
        || ('hierarchyLevel' in member && member.hierarchyLevel in ['director', 'owner'])
        || !('teamId' in resource.data)
        || resource.data.teamId == null
        || member.teamId == resource.data.teamId
        || ('teamIds' in member && resource.data.teamId in member.teamIds);
    }

    // ======== ORGANIZATIONS ========

    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn(); // Creating new org
      allow update: if isAdmin(orgId);
      allow delete: if isOwner(orgId);

      // Members (was "memberships" — fixed to match code path orgs/{orgId}/members)
      match /members/{userId} {
        allow read: if isOrgMember(orgId);
        allow create: if isAdmin(orgId);
        // Admins can update any field EXCEPT: only owner can assign role='owner'.
        // Self-edits cannot touch role, active, or hierarchyLevel.
        allow update: if (isAdmin(orgId) &&
          // Anti-escalation: only the current owner can grant the 'owner' role
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
           request.resource.data.role != 'owner' ||
           isOwner(orgId))) ||
          (isSelf(userId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'hierarchyLevel']));
        allow delete: if isOwner(orgId);

        // User preferences (stored per-member)
        match /preferences/{prefKey} {
          allow read: if isSignedIn() && isSelf(userId);
          allow write: if isSignedIn() && isSelf(userId);
        }

        // Chat bookmarks — self-only saved messages
        match /bookmarks/{bookmarkId} {
          allow read: if isSignedIn() && isSelf(userId);
          allow create: if isSignedIn() && isSelf(userId);
          allow delete: if isSignedIn() && isSelf(userId);
        }

        // User favorites — self-only
        match /favorites/{favoriteId} {
          allow read: if isSignedIn() && isSelf(userId);
          allow create: if isSignedIn() && isSelf(userId);
          allow delete: if isSignedIn() && isSelf(userId);
        }
      }

      // Invitations
      match /invitations/{inviteId} {
        allow read: if isOrgMember(orgId);
        allow create: if isAdmin(orgId);
        allow update: if isAdmin(orgId);
        allow delete: if isAdmin(orgId);
      }

      // Settings
      match /settings/{settingId} {
        allow read: if isOrgMember(orgId);
        allow write: if isAdmin(orgId);

        // Custom Roles — admin-only write, authenticated org members can read
        match /customRoles/{roleId} {
          allow read: if isOrgMember(orgId);
          allow create: if isAdmin(orgId);
          allow update: if isAdmin(orgId);
          allow delete: if isAdmin(orgId);
        }
      }

      // Shared space views — space members can read, manager+ in space can write
      match /spaceSharedViews/{spaceId} {
        allow read: if isSignedIn() && isOrgMember(orgId) && canAccessSpaceById(orgId, spaceId);
        allow write: if isSignedIn() && isManager(orgId) && canAccessSpaceById(orgId, spaceId);
      }

      // Teams
      match /teams/{teamId} {
        allow read: if isOrgMember(orgId);
        allow create: if isAdmin(orgId);
        allow update: if isManager(orgId);
        allow delete: if isAdmin(orgId);
      }

      // Presence
      match /presence/{userId} {
        allow read: if isOrgMember(orgId);
        allow write: if isSignedIn() && isSelf(userId);
      }

      // Active Viewers — tracks who is currently viewing a resource
      // Any org member can read (to see who else is viewing).
      // Any org member can write (join/leave viewing).
      match /activeViewers/{resourceKey} {
        allow read: if isSignedIn() && isOrgMember(orgId);
        allow write: if isSignedIn() && isOrgMember(orgId);
      }

      // Edit Locks — advisory locks for concurrent editing awareness
      // Any org member can read (to check if a resource is locked).
      // Any org member can write (acquire/release lock).
      match /editLocks/{resourceId} {
        allow read: if isSignedIn() && isOrgMember(orgId);
        allow write: if isSignedIn() && isOrgMember(orgId);
      }

      // Read cursors — tracks which messages each user has read per channel
      // Self-only: no reason for other users to read your cursors (no "seen" feature).
      match /readCursors/{userId} {
        allow read: if isSignedIn() && isSelf(userId);
        allow write: if isSignedIn() && isSelf(userId);
      }

      // Notifications (code writes to orgs/{orgId}/notifications)
      // Hardened: actorId must match caller, type must be from known set,
      // title/message must be strings with sane lengths.
      match /notifications/{notifId} {
        allow read: if isSignedIn() && isSelf(resource.data.userId);
        allow create: if isSignedIn() && isOrgMember(orgId)
          && (!request.resource.data.keys().hasAny(['actorId']) || request.resource.data.actorId == request.auth.uid)
          && request.resource.data.userId is string
          && request.resource.data.type is string && request.resource.data.type.size() <= 50
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.message is string && request.resource.data.message.size() <= 1000;
        allow update: if isSignedIn() && isSelf(resource.data.userId); // Mark as read
        allow delete: if isSignedIn() && isSelf(resource.data.userId);
      }

      // Event Logs — persistent trace of dispatched events
      // Write-only for members (append-only audit trail).
      // Read restricted to manager+ for debugging/auditing.
      match /eventLogs/{logId} {
        allow read: if isSignedIn() && isManager(orgId);
        allow create: if isSignedIn() && isOrgMember(orgId)
          && request.resource.data.correlationId is string
          && request.resource.data.event is string
          && request.resource.data.entityType is string;
        allow update, delete: if false; // Immutable audit trail
      }

      // Dashboards
      match /dashboards/{dashId} {
        allow read: if isSignedIn() && isSelf(resource.data.userId);
        allow create: if isSignedIn() && isOrgMember(orgId);
        allow update: if isSignedIn() && isSelf(resource.data.userId);
        allow delete: if isSignedIn() && isSelf(resource.data.userId);
      }

      // Inbox — self-only: users can only access their own inbox items
      // Server-side (Admin SDK) bypasses rules; client can only create for self.
      match /inbox/{itemId} {
        allow read: if isSignedIn() && isOrgMember(orgId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isOrgMember(orgId) && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && isOrgMember(orgId) && resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && isOrgMember(orgId) && resource.data.userId == request.auth.uid;
      }

      // AI Conversations — self-only: users can only access their own conversations
      match /ai-conversations/{convId} {
        allow read: if isSignedIn() && isOrgMember(orgId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isOrgMember(orgId) && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && isOrgMember(orgId) && resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && isOrgMember(orgId) && resource.data.userId == request.auth.uid;

        match /messages/{msgId} {
          allow read: if isSignedIn() && isOrgMember(orgId)
            && get(/databases/$(database)/documents/orgs/$(orgId)/ai-conversations/$(convId)).data.userId == request.auth.uid;
          allow create: if isSignedIn() && isOrgMember(orgId)
            && get(/databases/$(database)/documents/orgs/$(orgId)/ai-conversations/$(convId)).data.userId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // Views — first-class saved views (filters, sorts, groupings)
      // Read: org member + view is not private OR user is the creator
      // Create: full members for private views; manager+ for required/default visibility
      // Update: creator OR manager+
      // Delete: creator OR admin+
      match /views/{viewId} {
        allow read: if isSignedIn() && isOrgMember(orgId)
          && (resource.data.visibility != 'private'
              || resource.data.createdBy == request.auth.uid);
        allow create: if isSignedIn() && isOrgMember(orgId)
          && (
            // Private views: any full member (not guest/readonly)
            (request.resource.data.visibility == 'private' && isFullMember(orgId))
            // Required/default views: manager+ only
            || (request.resource.data.visibility in ['required', 'default'] && isManager(orgId))
            // All other visibilities (e.g. 'shared'): full member
            || (!(request.resource.data.visibility in ['private', 'required', 'default']) && isFullMember(orgId))
          );
        allow update: if isSignedIn() && isOrgMember(orgId)
          && (resource.data.createdBy == request.auth.uid || isManager(orgId));
        allow delete: if isSignedIn() && isOrgMember(orgId)
          && (resource.data.createdBy == request.auth.uid || isAdmin(orgId));
      }

      // Access Requests — users request access to restricted resources
      // Create: any org member can submit a request
      // Read: requester can see their own requests; manager+ can see all
      // Update: manager+ only (approve/deny)
      // Delete: admin only
      match /accessRequests/{requestId} {
        allow create: if isSignedIn() && isOrgMember(orgId);
        allow read: if isSignedIn() && isOrgMember(orgId)
          && (resource.data.requesterId == request.auth.uid || isManager(orgId));
        allow update: if isSignedIn() && isManager(orgId);
        allow delete: if isSignedIn() && isAdmin(orgId);
      }
    }

    // ======== USER PROFILES (UNUSED — app uses orgs/{orgId}/members) ========
    // Locked: no app code reads/writes this collection. Kept for backwards compat
    // with any pre-existing data; read is self-only, all writes denied.

    match /users/{userId} {
      allow read: if isSignedIn() && isSelf(userId);
      allow create, update, delete: if false;
    }

    // ======== WORKSPACES ========

    match /workspaces/{workspaceId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isAdmin(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== SPACES ========

    match /spaces/{spaceId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== FOLDERS ========
    // Scoped by spaceId (= teamId). Team-level isolation enforced via canAccessTeamData
    // which checks admin/director bypass, or team membership via teamId/teamIds.
    // Note: folders store spaceId (not teamId), so canAccessTeamData reads resource.data.spaceId
    // via the same pattern (admin bypass || member.teamId == spaceId || spaceId in member.teamIds).

    function canAccessSpaceData(orgId) {
      let member = get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
      return member.role in ['owner', 'admin']
        || ('hierarchyLevel' in member && member.hierarchyLevel in ['director', 'owner'])
        || !('spaceId' in resource.data)
        || resource.data.spaceId == null
        || member.teamId == resource.data.spaceId
        || ('teamIds' in member && resource.data.spaceId in member.teamIds);
    }

    // Space access check by explicit spaceId parameter (for docs where spaceId is in path, not data)
    function canAccessSpaceById(orgId, sid) {
      let member = get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
      return member.role in ['owner', 'admin']
        || ('hierarchyLevel' in member && member.hierarchyLevel in ['director', 'owner'])
        || member.teamId == sid
        || ('teamIds' in member && sid in member.teamIds);
    }

    // Validate that a listId belongs to the task's teamId (cross-space integrity)
    function listBelongsToTeam(lid, tid) {
      return get(/databases/$(database)/documents/lists/$(lid)).data.spaceId == tid;
    }

    // Validate that a folderId belongs to a given spaceId (cross-space integrity for docs/whiteboards)
    function folderBelongsToSpace(fid, sid) {
      return get(/databases/$(database)/documents/folders/$(fid)).data.spaceId == sid;
    }

    match /folders/{folderId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId) && canAccessSpaceData(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && canAccessSpaceData(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    // ======== LISTS ========
    // Same team-level isolation as folders via canAccessSpaceData.
    // Create gated to manager+ (structural decision: members use structure, managers define it).
    // Per-list ACL: if visibility == 'private', only list members or manager+ can read.

    match /lists/{listId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId) && canAccessSpaceData(resource.data.orgId)
        && (!('visibility' in resource.data) || resource.data.visibility != 'private'
            || request.auth.uid in resource.data.members
            || isManager(resource.data.orgId));
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && canAccessSpaceData(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    // ======== TASKS ========

    match /tasks/{taskId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId) && canAccessTeamData(resource.data.orgId);
      // Create: guests can create tasks; listId must be null OR belong to the same team
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId)
        && (request.resource.data.listId == null
            || listBelongsToTeam(request.resource.data.listId, request.resource.data.teamId));
      // Update: full members only (guests and readonly cannot update)
      allow update: if isSignedIn() && isFullMember(resource.data.orgId)
        && orgIdUnchanged()
        && (request.resource.data.listId == null
            || request.resource.data.listId == resource.data.listId
            || listBelongsToTeam(request.resource.data.listId, resource.data.teamId));
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      // Cross-org leak fix: verify parent task's orgId for subcollections
      match /comments/{commentId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow update: if isSignedIn() && request.auth.uid == resource.data.createdBy;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;
      }

      match /activity/{activityId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.orgId);
        allow update, delete: if false; // Activity log is immutable
      }
    }

    // ======== DOCS ========
    // folderId must be null OR belong to same space as doc.teamId

    match /docs/{docId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId) && canAccessTeamData(resource.data.orgId);
      // Guests cannot create or update docs
      allow create: if isSignedIn() && isFullMember(request.resource.data.orgId)
        && (!('folderId' in request.resource.data) || request.resource.data.folderId == null
            || folderBelongsToSpace(request.resource.data.folderId, request.resource.data.teamId));
      allow update: if isSignedIn() && isFullMember(resource.data.orgId)
        && orgIdUnchanged()
        && (!('folderId' in request.resource.data) || request.resource.data.folderId == null
            || request.resource.data.folderId == resource.data.folderId
            || folderBelongsToSpace(request.resource.data.folderId, resource.data.teamId))
        // structural move (folderId change) requires manager+
        && (request.resource.data.get('folderId', null) == resource.data.get('folderId', null)
            || isManager(resource.data.orgId));
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /revisions/{revisionId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        allow update, delete: if false; // Revisions are immutable
      }

      // Doc Comments — general comments on the document
      match /comments/{commentId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId)
          && resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid || isManager(get(/databases/$(database)/documents/docs/$(docId)).data.orgId));
      }

      // Inline Comments — threaded comments anchored to text ranges
      match /inlineComments/{commentId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId);
        // Only author can edit text/textAnchor; any org member can resolve/unresolve
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/docs/$(docId)).data.orgId)
          && (resource.data.authorId == request.auth.uid
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'textAnchor', 'authorId']));
        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid || isManager(get(/databases/$(database)/documents/docs/$(docId)).data.orgId));
      }
    }

    // ======== CHANNELS ========
    // Privacy model: public channels accessible to all org members.
    // Private/DM channels require membership in the members array.
    // Managers+ can always access all channels for oversight/moderation.

    match /channels/{channelId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId) &&
        (resource.data.type == 'public' ||
         request.auth.uid in resource.data.members ||
         isManager(resource.data.orgId));
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && orgIdUnchanged() &&
        (resource.data.type == 'public' ||
         request.auth.uid in resource.data.members ||
         isManager(resource.data.orgId));
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);

      // Messages: channel membership enforced for private/DM channels.
      // Fix: userId (not createdBy) is the author field on messages.
      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId) &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'public' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId));
        allow create: if isSignedIn() &&
          isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId) &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'public' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId));
        allow update: if isSignedIn() &&
          (request.auth.uid == resource.data.userId ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId)) &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'public' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId));
        allow delete: if isSignedIn() &&
          (request.auth.uid == resource.data.userId ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId)) &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'public' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId));
      }

      // Typing indicators and channel metadata — same access as channel
      match /meta/{docId} {
        allow read: if isSignedIn() &&
          isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId) &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'public' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId));
        allow write: if isSignedIn() &&
          isOrgMember(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId) &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'public' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members ||
           isManager(get(/databases/$(database)/documents/channels/$(channelId)).data.orgId));
      }
    }

    // ======== GOALS ========

    match /goals/{goalId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId) && canAccessTeamData(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && canAccessTeamData(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /targets/{targetId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow delete: if isSignedIn() && isManager(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
      }

      match /checkins/{checkinId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow update: if isSignedIn()
          && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId)
          && (request.auth.uid == resource.data.authorId || isManager(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId));
        allow delete: if isSignedIn() && isManager(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
      }

      match /settings/{settingId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow create, update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
        allow delete: if isSignedIn() && isManager(get(/databases/$(database)/documents/goals/$(goalId)).data.orgId);
      }
    }

    // ======== WHITEBOARDS ========
    // Team-isolated reads + folderId must be null OR belong to same space

    match /whiteboards/{boardId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId) && canAccessTeamData(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId)
        && (!('folderId' in request.resource.data) || request.resource.data.folderId == null
            || folderBelongsToSpace(request.resource.data.folderId, request.resource.data.teamId));
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId)
        && orgIdUnchanged()
        && (!('folderId' in request.resource.data) || request.resource.data.folderId == null
            || request.resource.data.folderId == resource.data.folderId
            || folderBelongsToSpace(request.resource.data.folderId, resource.data.teamId))
        // structural move (folderId change) requires manager+
        && (request.resource.data.get('folderId', null) == resource.data.get('folderId', null)
            || isManager(resource.data.orgId));
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /elements/{elementId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
        allow delete: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/whiteboards/$(boardId)).data.orgId);
      }
    }

    // ======== FORMS ========

    match /forms/{formId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      // Public form access by publicToken is handled via API routes, not direct Firestore reads
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);

      match /submissions/{subId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow create: if false; // Public submissions go through /api/forms/submit (Admin SDK) — no direct client writes
        allow update, delete: if isSignedIn() && isAdmin(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
      }

      match /mappings/{mappingId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow create: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow update: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
        allow delete: if isSignedIn() && isAdmin(get(/databases/$(database)/documents/forms/$(formId)).data.orgId);
      }
    }

    // ======== TIME ENTRIES ========

    match /time-entries/{entryId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId)
        && orgIdUnchanged();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isManager(resource.data.orgId));
    }

    // ======== AUTOMATIONS ========

    match /automations/{automationId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);

      match /logs/{logId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/automations/$(automationId)).data.orgId);
        allow create: if false; // Only Cloud Functions write logs
        allow update, delete: if false;
      }
    }

    // ======== NOTIFICATIONS (top-level — legacy, LOCKED) ========
    // App uses orgs/{orgId}/notifications. This legacy collection is locked to prevent
    // abuse by any signed-in user. Read/update/delete for existing docs only.

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if false; // LOCKED — use orgs/{orgId}/notifications instead
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ======== AUDIT LOGS ========
    // Client-writable by design (UI pages log actions directly).
    // Hardened: org membership required, actorId must match auth, known fields only,
    // string types enforced, lengths capped. NOT forensically trustworthy — treat as
    // best-effort operational log, not as security evidence.

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      allow create: if isSignedIn()
        && isOrgMember(request.resource.data.orgId)
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasAll(['action', 'resource', 'detail', 'actorId', 'actorName', 'orgId'])
        && request.resource.data.action is string && request.resource.data.action.size() <= 50
        && request.resource.data.resource is string && request.resource.data.resource.size() <= 50
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 500
        && request.resource.data.actorName is string && request.resource.data.actorName.size() <= 100;
      allow update, delete: if false; // Audit logs are immutable
    }

    // ======== INSIGHTS ========

    match /insights/{insightId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if false; // Only Cloud Functions / server-side
      allow update, delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== TEMPLATES ========

    match /templates/{templateId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== EMAIL TEMPLATES ========

    match /emailTemplates/{templateId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isAdmin(request.resource.data.orgId);
      allow update: if isSignedIn() && isAdmin(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== ROLES (UNUSED — no app code references this collection) ========

    match /roles/{roleId} {
      allow read, write: if false;
    }

    // ======== CUSTOM FIELD SCHEMAS (UNUSED — app uses orgs/{orgId}/settings/customFields) ========

    match /customFieldSchemas/{schemaId} {
      allow read, write: if false;
    }

    // ======== INTEGRATIONS ========

    match /integrations/{integrationId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== API KEYS ========

    match /apiKeys/{keyId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      allow create: if isSignedIn() && isAdmin(request.resource.data.orgId);
      allow update: if isSignedIn() && isAdmin(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== WEBHOOKS ========

    match /webhooks/{webhookId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);

      match /logs/{logId} {
        allow read: if isSignedIn() && isOrgMember(get(/databases/$(database)/documents/webhooks/$(webhookId)).data.orgId);
        allow create: if false; // Only server-side
        allow update, delete: if false;
      }
    }

    // ======== INCOMING WEBHOOKS ========

    match /incomingWebhooks/{webhookId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update: if isSignedIn() && isManager(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isAdmin(resource.data.orgId);
    }

    // ======== WEBHOOK EVENTS ========

    match /webhookEvents/{eventId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      allow create: if false; // Only server-side
      allow update, delete: if false;
    }

    // ======== CRM ========

    match /contacts/{contactId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    match /deals/{dealId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    match /cases/{caseId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    // Entity Relations
    match /relations/{relationId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.createdBy || isManager(resource.data.orgId));
      allow update: if false;
    }

    // Import Logs
    match /importLogs/{logId} {
      allow read: if isSignedIn() && isAdmin(resource.data.orgId);
      allow create: if isSignedIn() && isManager(request.resource.data.orgId);
      allow update, delete: if false;
    }

    // ======== SHARE LINKS ========

    match /shareLinks/{linkId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn()
        && isOrgMember(resource.data.orgId)
        && orgIdUnchanged()
        && (request.auth.uid == resource.data.createdBy || isManager(resource.data.orgId));
      allow delete: if isSignedIn()
        && isOrgMember(resource.data.orgId)
        && (request.auth.uid == resource.data.createdBy || isManager(resource.data.orgId));
    }

    // ======== GOAL TEMPLATES ========

    match /goalTemplates/{templateId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isManager(resource.data.orgId);
    }

    // ======== TASK LINKS (GitHub PRs, commits, branches) ========

    match /taskLinks/{linkId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && isOrgMember(request.resource.data.orgId);
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && orgIdUnchanged();
      allow delete: if isSignedIn() && isOrgMember(resource.data.orgId);
    }
  }
}
