rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Docs images — authenticated users can read/write
    match /docs/{docId}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat uploads — authenticated users can read/write
    match /chat-uploads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Task uploads — authenticated users can read/write
    match /task-uploads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Public form uploads — anonymous users can upload (rate-limited at API layer)
    match /form-uploads/{formId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024; // 10MB per file
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
