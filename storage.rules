rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Docs images — authenticated users can read/write
    // SVG excluded (XSS vector) — only raster image formats allowed
    match /docs/{docId}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|gif|webp)');
    }

    // Chat uploads — authenticated users can read/write
    // Content-type allowlist: images, PDFs, Office docs, plain text
    match /chat-uploads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('(image/(png|jpeg|gif|webp)|application/pdf|application/(msword|vnd\\.openxmlformats.*|vnd\\.ms-excel.*)|text/plain)');
    }

    // Task uploads — authenticated users can read/write
    // Content-type allowlist: images, PDFs, Office docs, plain text
    match /task-uploads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('(image/(png|jpeg|gif|webp)|application/pdf|application/(msword|vnd\\.openxmlformats.*|vnd\\.ms-excel.*)|text/plain)');
    }

    // Public form uploads — anonymous users can upload with restrictions
    // Rate limiting enforced at API layer; storage rules enforce size + content type
    match /form-uploads/{formId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('(image|application/pdf|text)/.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
